# macOS
.DS_Store

# Build output
build/

# `bmake docs` output (Doxygen) inside the example workspace -- generated,
# not source; docs/ at the repo root (spec, manual.tex) is unaffected since
# this pattern is scoped under examples/.
examples/**/docs/

# Generated by gen-mod-order.sh / gen-fw-order.sh (regenerated on every parse)
.gen-mod-order.mk
.gen-fw-order.mk
.depend

# Object/library/executable artifacts (in case they escape build/)
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# LaTeX build byproducts
*.aux
*.log
*.out
*.toc

# discovery-driven-dev's auto-bundle: regenerated by every project-model
# write, pure noise on main. The durable copies are project-model-backup
# on GitHub (via .backup-remote.json) and, when running in a claude.ai
# sandbox, /mnt/user-data/outputs/.
project-model-backup.tar.gz
